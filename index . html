<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Absahnaz Care Foundation | Management Portal</title>
<style>
:root{--navy:#09264a;--navy2:#123b69;--gold:#d9a126;--bg:#f4f6fa;--ink:#1c2f49;--muted:#66758a;--line:#e2e8f0;--white:#fff;--green:#147d55;--red:#b53a3a}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer}.layout{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{background:var(--navy);color:#fff;padding:24px 16px;display:flex;flex-direction:column;gap:24px}.brand{display:flex;align-items:center;gap:10px;padding:0 8px}.logo{width:42px;height:42px;border:2px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:21px;font-weight:bold}.brand strong{font-size:13px;letter-spacing:.04em;display:block}.brand small{font-size:11px;color:#c8d5e4}.nav{display:grid;gap:6px}.nav button{border:0;background:transparent;color:#dce5ef;text-align:left;padding:12px;border-radius:9px;font-weight:600}.nav button.active,.nav button:hover{background:#ffffff1a;color:#fff}.sidebar-note{margin-top:auto;font-size:12px;color:#c6d4e5;line-height:1.6;border-top:1px solid #ffffff30;padding:16px 8px 0}.main{min-width:0}.topbar{background:#fff;border-bottom:1px solid var(--line);padding:17px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px}.topbar h1{margin:0;font-size:20px;color:var(--navy)}.topbar p{margin:3px 0 0;color:var(--muted);font-size:12px}.badge{border-radius:99px;background:#fff4d8;color:#7d5708;padding:7px 10px;font-size:11px;font-weight:700}.content{padding:26px;max-width:1400px;margin:auto}.notice{border:1px solid #f0d58b;background:#fff9e9;color:#694e10;border-radius:12px;padding:14px 16px;font-size:13px;line-height:1.55;margin-bottom:20px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}.stat,.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 4px 16px #0b2b4d05}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;font-size:27px;color:var(--navy);margin-top:7px}.stat small{color:var(--muted);font-size:11px}.panel{margin-bottom:18px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:15px}.panel h2{font-size:16px;color:var(--navy);margin:0}.muted{color:var(--muted);font-size:13px}.btn{border:0;border-radius:9px;background:var(--gold);color:#182941;padding:10px 14px;font-weight:700}.btn.secondary{background:#eef2f7;color:var(--navy)}.btn.danger{background:#ffeded;color:var(--red)}.btn.small{padding:7px 10px;font-size:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:700;color:#43536a}.field input,.field select,.field textarea,.search{width:100%;padding:11px;border:1px solid #d9e1eb;border-radius:8px;background:#fff;color:var(--ink)}.field textarea{min-height:82px;resize:vertical}.form-actions{display:flex;gap:9px;margin-top:15px;flex-wrap:wrap}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:600px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:12px 10px;font-size:12px;vertical-align:top}th{color:#66758a;font-size:11px;text-transform:uppercase;letter-spacing:.04em;background:#fafbfd}td strong{color:var(--navy)}.pill{display:inline-block;border-radius:99px;padding:4px 8px;background:#edf2f8;color:#43536a;font-size:10px;font-weight:700}.pill.green{background:#e3f7ed;color:#126544}.pill.gold{background:#fff2ce;color:#805b08}.pill.red{background:#ffe9e9;color:#a52f2f}.empty{padding:25px;text-align:center;color:var(--muted);font-size:13px}.section{display:none}.section.active{display:block}.actions{display:flex;gap:7px;flex-wrap:wrap}.footer{padding:10px 0 24px;color:var(--muted);font-size:11px;text-align:center}.mobilebrand{display:none}
@media(max-width:900px){.layout{grid-template-columns:1fr}.sidebar{padding:12px;gap:12px}.brand{padding:4px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;padding:10px}.sidebar-note{display:none}.stats{grid-template-columns:repeat(2,1fr)}.content{padding:16px}.topbar{padding:15px 18px}.grid2{grid-template-columns:1fr}}
@media(max-width:560px){.stats{grid-template-columns:1fr 1fr;gap:8px}.stat{padding:13px}.stat strong{font-size:22px}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.topbar h1{font-size:17px}.badge{display:none}}
</style>
</head>
<body>
<div class="layout">
<aside class="sidebar">
  <div class="brand"><div class="logo">A</div><div><strong>ABSAHNAZ CARE</strong><small>FOUNDATION PORTAL</small></div></div>
  <nav class="nav" aria-label="Portal navigation">
    <button class="active" data-view="dashboard">▦ &nbsp; Dashboard</button>
    <button data-view="children">♡ &nbsp; Children</button>
    <button data-view="members">♙ &nbsp; Members & Volunteers</button>
    <button data-view="donations">＋ &nbsp; Donations</button>
    <button data-view="reports">▤ &nbsp; Reports & Data</button>
  </nav>
  <div class="sidebar-note">Every Child Deserves an Education.<br><br>Prototype portal — not yet secured for online use.</div>
</aside>
<main class="main">
<header class="topbar"><div><h1 id="pageTitle">Dashboard</h1><p>Absahnaz Care Foundation · Damaturu, Yobe State</p></div><span class="badge">DEMO / LOCAL ONLY</span></header>
<div class="content">
<div class="notice"><strong>Important privacy notice:</strong> This is a demonstration that saves entries in this browser on this device only. Do not enter real children's sensitive information or use this for live operations yet. It has no secure login, encrypted server, backup, or multi-user access. Before real use, have it professionally secured and establish child-protection procedures.</div>

<section class="section active" id="dashboard">
<div class="stats">
 <div class="stat"><span>Children recorded</span><strong id="statChildren">0</strong><small>Initial target: 5</small></div>
 <div class="stat"><span>Members / volunteers</span><strong id="statMembers">0</strong><small>Registrations in this demo</small></div>
 <div class="stat"><span>Total donations recorded</span><strong id="statDonations">₦0</strong><small>Recordkeeping only; no payments accepted</small></div>
 <div class="stat"><span>Education expenses</span><strong id="statExpenses">₦0</strong><small>Expenses entered in child records</small></div>
</div>
<div class="grid2">
 <div class="panel"><div class="panel-head"><h2>Quick actions</h2></div><p class="muted">Keep your first project small, documented, and sustainable.</p><div class="actions"><button class="btn" onclick="showView('children')">＋ Add child record</button><button class="btn secondary" onclick="showView('members')">Register volunteer</button><button class="btn secondary" onclick="showView('donations')">Record donation</button></div></div>
 <div class="panel"><div class="panel-head"><h2>Project checklist</h2></div><p class="muted">Before sponsoring a child, confirm:</p><ul class="muted"><li>Parent or guardian consent and child's willingness.</li><li>School placement and verified fee schedule.</li><li>Funding plan before promising ongoing fees.</li><li>Safe, private recordkeeping and follow-up.</li></ul></div>
</div>
<div class="panel"><div class="panel-head"><h2>Recent activity</h2><span class="muted">This browser only</span></div><div id="recentActivity" class="empty">No activity yet. Use the quick actions to begin a demo record.</div></div>
</section>

<section class="section" id="children">
<div class="panel"><div class="panel-head"><div><h2>Child education records</h2><div class="muted">Use a code or initials rather than a full name in this demo.</div></div></div>
<form id="childForm">
<div class="formgrid">
 <div class="field"><label for="childCode">Child code / initials *</label><input id="childCode" required maxlength="30" placeholder="e.g. ACF-001"></div>
 <div class="field"><label for="childAge">Age</label><input id="childAge" type="number" min="3" max="18" placeholder="Age"></div>
 <div class="field"><label for="childCategory">Program *</label><select id="childCategory" required><option value="">Select program</option><option>Back-to-School</option><option>Almajiri Education Support</option><option>Educational Sponsorship</option><option>Other education support</option></select></div>
 <div class="field"><label for="childSchool">School / proposed placement</label><input id="childSchool" placeholder="School name"></div>
 <div class="field"><label for="childStatus">Status *</label><select id="childStatus" required><option>Assessment pending</option><option>Guardian consent confirmed</option><option>Enrolled</option><option>Ongoing support</option><option>Completed</option><option>On hold</option></select></div>
 <div class="field"><label for="childFees">Verified education costs (₦)</label><input id="childFees" type="number" min="0" step="1" placeholder="0"></div>
 <div class="field"><label for="childPaid">Expenses paid (₦)</label><input id="childPaid" type="number" min="0" step="1" placeholder="0"></div>
 <div class="field"><label for="childReview">Next follow-up date</label><input id="childReview" type="date"></div>
 <div class="field full"><label for="childNotes">Non-sensitive notes</label><textarea id="childNotes" maxlength="500" placeholder="e.g. Needs school uniform; follow up with school. Do not enter medical details or home address."></textarea></div>
</div><div class="form-actions"><button class="btn" type="submit">Save child record</button><button class="btn secondary" type="reset">Clear form</button></div>
</form></div>
<div class="panel"><div class="panel-head"><h2>Children list</h2><input class="search" style="max-width:260px" id="childSearch" placeholder="Search code, school, status…"></div><div class="tablewrap"><table><thead><tr><th>Code</th><th>Program</th><th>School</th><th>Status</th><th>Costs / Paid</th><th>Follow-up</th><th>Action</th></tr></thead><tbody id="childrenTable"></tbody></table></div><div id="childrenEmpty" class="empty">No child records yet.</div></div>
</section>

<section class="section" id="members">
<div class="panel"><div class="panel-head"><div><h2>Member and volunteer registration</h2><div class="muted">Collect only the information needed to contact and coordinate volunteers.</div></div></div>
<form id="memberForm"><div class="formgrid">
 <div class="field"><label for="memberName">Full name *</label><input id="memberName" required maxlength="100" autocomplete="name"></div>
 <div class="field"><label for="memberRole">Interested in *</label><select id="memberRole" required><option value="">Choose role</option><option>Volunteer</option><option>Member</option><option>Education mentor</option><option>School / community partner</option><option>Donor / sponsor</option></select></div>
 <div class="field"><label for="memberEmail">Email</label><input id="memberEmail" type="email" maxlength="150" autocomplete="email"></div>
 <div class="field"><label for="memberPhone">Phone number</label><input id="memberPhone" type="tel" maxlength="30" autocomplete="tel"></div>
 <div class="field"><label for="memberLocation">City / state</label><input id="memberLocation" maxlength="100" placeholder="e.g. Damaturu, Yobe"></div>
 <div class="field"><label for="memberAvailability">Availability</label><select id="memberAvailability"><option>Flexible</option><option>Weekdays</option><option>Weekends</option><option>Remote support</option></select></div>
 <div class="field full"><label for="memberSkills">Skills or areas of interest</label><textarea id="memberSkills" maxlength="500" placeholder="e.g. teaching, community outreach, fundraising"></textarea></div>
</div><div class="form-actions"><button class="btn" type="submit">Save registration</button><button class="btn secondary" type="reset">Clear form</button></div></form></div>
<div class="panel"><div class="panel-head"><h2>Registrations</h2><input class="search" style="max-width:260px" id="memberSearch" placeholder="Search name, role, location…"></div><div class="tablewrap"><table><thead><tr><th>Name</th><th>Interest</th><th>Contact</th><th>Location</th><th>Availability</th><th>Action</th></tr></thead><tbody id="membersTable"></tbody></table></div><div id="membersEmpty" class="empty">No member or volunteer registrations yet.</div></div>
</section>

<section class="section" id="donations">
<div class="panel"><div class="panel-head"><div><h2>Record a donation</h2><div class="muted">This records a donation that has already been received. It does not process payments.</div></div></div>
<form id="donationForm"><div class="formgrid">
 <div class="field"><label for="donorName">Donor name or reference *</label><input id="donorName" required maxlength="100" placeholder="Name or anonymous"></div>
 <div class="field"><label for="donationAmount">Amount (₦) *</label><input id="donationAmount" type="number" min="1" step="1" required></div>
 <div class="field"><label for="donationDate">Date received *</label><input id="donationDate" type="date" required></div>
 <div class="field"><label for="donationPurpose">Purpose *</label><select id="donationPurpose" required><option value="">Choose purpose</option><option>School fees</option><option>Books and supplies</option><option>Uniform</option><option>General education support</option><option>Operating costs</option><option>Restricted / other</option></select></div>
 <div class="field full"><label for="donationRef">Receipt / transaction reference (optional)</label><input id="donationRef" maxlength="100"></div>
</div><div class="form-actions"><button class="btn" type="submit">Save donation record</button><button class="btn secondary" type="reset">Clear form</button></div></form></div>
<div class="panel"><div class="panel-head"><h2>Donation ledger</h2></div><div class="tablewrap"><table><thead><tr><th>Date</th><th>Donor reference</th><th>Purpose</th><th>Amount</th><th>Receipt reference</th><th>Action</th></tr></thead><tbody id="donationsTable"></tbody></table></div><div id="donationsEmpty" class="empty">No donation records yet.</div></div>
</section>

<section class="section" id="reports">
<div class="panel"><div class="panel-head"><h2>Reports and data management</h2></div><p class="muted">Export the demo records as a JSON file for a basic local copy, or clear this browser's saved demo data. Store exports securely. This is not a substitute for secure backups or audited accounting.</p><div class="actions"><button class="btn" id="exportBtn">Export records (JSON)</button><button class="btn secondary" id="printBtn">Print summary</button><button class="btn danger" id="clearBtn">Clear all demo data</button></div><hr style="border:0;border-top:1px solid var(--line);margin:22px 0"><h2>Data and child-safety checklist</h2><ul class="muted"><li>Use written parent/guardian consent and age-appropriate child assent.</li><li>Limit access to child records to authorized staff.</li><li>Do not publish identifiable child photos or personal stories without valid informed consent and safeguards.</li><li>Keep financial receipts and reconcile donations against expenses.</li><li>Before online launch, add authentication, server-side access controls, encryption, backups, privacy notice, and secure hosting.</li><li>Confirm registration and applicable legal requirements before public fundraising.</li></ul></div>
<div class="panel"><div class="panel-head"><h2>Current summary</h2></div><div id="reportSummary" class="muted"></div></div>
</section>
<div class="footer">Absahnaz Care Foundation · Prototype management portal · Not for live child records yet</div>
</div>
</main></div>
<script>
const STORAGE_KEY='absahnaz_portal_demo_v1';
let data={children:[],members:[],donations:[],activity:[]};
const $=id=>document.getElementById(id);
function load(){try{const x=JSON.parse(localStorage.getItem(STORAGE_KEY));if(x)data={...data,...x}}catch(e){}}
function save(){localStorage.setItem(STORAGE_KEY,JSON.stringify(data));render();addActivity('Records updated');}
function addActivity(msg){data.activity.unshift({msg,date:new Date().toLocaleString()});data.activity=data.activity.slice(0,8);localStorage.setItem(STORAGE_KEY,JSON.stringify(data));}
function showView(view){document.querySelectorAll('.section').forEach(s=>s.classList.toggle('active',s.id===view));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===view));const titles={dashboard:'Dashboard',children:'Children',members:'Members & Volunteers',donations:'Donations',reports:'Reports & Data'};$('pageTitle').textContent=titles[view]||'Dashboard';window.scrollTo({top:0,behavior:'smooth'});}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));
function money(n){return '₦'+Number(n||0).toLocaleString('en-NG',{maximumFractionDigits:0})}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function statusPill(s){let cls=s==='Enrolled'||s==='Ongoing support'||s==='Completed'?'green':s==='On hold'?'red':'gold';return `<span class="pill ${cls}">${esc(s)}</span>`}
function render(){
 $('statChildren').textContent=data.children.length;$('statMembers').textContent=data.members.length;
 $('statDonations').textContent=money(data.donations.reduce((a,x)=>a+Number(x.amount||0),0));
 $('statExpenses').textContent=money(data.children.reduce((a,x)=>a+Number(x.paid||0),0));
 const cs=($('childSearch')?.value||'').toLowerCase();let children=data.children.filter(x=>[x.code,x.program,x.school,x.status].join(' ').toLowerCase().includes(cs));
 $('childrenTable').innerHTML=children.map(x=>`<tr><td><strong>${esc(x.code)}</strong><br><span class="muted">Age: ${esc(x.age||'—')}</span></td><td>${esc(x.program)}</td><td>${esc(x.school||'Not entered')}</td><td>${statusPill(x.status)}</td><td>${money(x.paid)} / ${money(x.fees)}</td><td>${esc(x.review||'Not set')}</td><td><button class="btn danger small" onclick="removeItem('children','${x.id}')">Delete</button></td></tr>`).join('');
 $('childrenEmpty').style.display=children.length?'none':'block';
 const ms=($('memberSearch')?.value||'').toLowerCase();let members=data.members.filter(x=>[x.name,x.role,x.location,x.email,x.phone].join(' ').toLowerCase().includes(ms));
 $('membersTable').innerHTML=members.map(x=>`<tr><td><strong>${esc(x.name)}</strong><br><span class="muted">${esc(x.skills||'')}</span></td><td>${esc(x.role)}</td><td>${esc(x.email||'')}${x.email&&x.phone?'<br>':''}${esc(x.phone||'')}</td><td>${esc(x.location||'—')}</td><td>${esc(x.availability||'Flexible')}</td><td><button class="btn danger small" onclick="removeItem('members','${x.id}')">Delete</button></td></tr>`).join('');
 $('membersEmpty').style.display=members.length?'none':'block';
 $('donationsTable').innerHTML=data.donations.map(x=>`<tr><td>${esc(x.date)}</td><td><strong>${esc(x.name)}</strong></td><td>${esc(x.purpose)}</td><td>${money(x.amount)}</td><td>${esc(x.ref||'—')}</td><td><button class="btn danger small" onclick="removeItem('donations','${x.id}')">Delete</button></td></tr>`).join('');
 $('donationsEmpty').style.display=data.donations.length?'none':'block';
 $('recentActivity').innerHTML=data.activity.length?data.activity.map(x=>`<div style="padding:9px 0;border-bottom:1px solid var(--line)"><strong>${esc(x.msg)}</strong><div class="muted">${esc(x.date)}</div></div>`).join(''):'No activity yet. Use the quick actions to begin a demo record.';
 $('reportSummary').innerHTML=`<p><strong>Child records:</strong> ${data.children.length} (initial target: 5)</p><p><strong>Members and volunteers:</strong> ${data.members.length}</p><p><strong>Total donations recorded:</strong> ${money(data.donations.reduce((a,x)=>a+Number(x.amount||0),0))}</p><p><strong>Education expenses entered:</strong> ${money(data.children.reduce((a,x)=>a+Number(x.paid||0),0))}</p><p><strong>Outstanding recorded education costs:</strong> ${money(data.children.reduce((a,x)=>a+Math.max(0,Number(x.fees||0)-Number(x.paid||0)),0))}</p>`;
}
function removeItem(type,id){if(!confirm('Delete this demo record?'))return;data[type]=data[type].filter(x=>x.id!==id);addActivity('A record was deleted');localStorage.setItem(STORAGE_KEY,JSON.stringify(data));render()}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
$('childForm').addEventListener('submit',e=>{e.preventDefault();data.children.push({id:uid(),code:$('childCode').value.trim(),age:$('childAge').value,program:$('childCategory').value,school:$('childSchool').value.trim(),status:$('childStatus').value,fees:$('childFees').value||0,paid:$('childPaid').value||0,review:$('childReview').value,notes:$('childNotes').value.trim()});e.target.reset();addActivity('Child education record added');localStorage.setItem(STORAGE_KEY,JSON.stringify(data));render();alert('Demo record saved in this browser only. Do not store real sensitive child information in this prototype.')});
$('memberForm').addEventListener('submit',e=>{e.preventDefault();if(!$('memberEmail').value.trim()&&!$('memberPhone').value.trim()){alert('Please enter an email address or phone number.');return}data.members.push({id:uid(),name:$('memberName').value.trim(),role:$('memberRole').value,email:$('memberEmail').value.trim(),phone:$('memberPhone').value.trim(),location:$('memberLocation').value.trim(),availability:$('memberAvailability').value,skills:$('memberSkills').value.trim()});e.target.reset();addActivity('Member / volunteer registration added');localStorage.setItem(STORAGE_KEY,JSON.stringify(data));render();alert('Demo registration saved on this device only.')});
$('donationForm').addEventListener('submit',e=>{e.preventDefault();data.donations.push({id:uid(),name:$('donorName').value.trim(),amount:Number($('donationAmount').value),date:$('donationDate').value,purpose:$('donationPurpose').value,ref:$('donationRef').value.trim()});e.target.reset();addActivity('Donation record added');localStorage.setItem(STORAGE_KEY,JSON.stringify(data));render();alert('Donation record saved. This form does not collect or process payments.')});
$('childSearch').addEventListener('input',render);$('memberSearch').addEventListener('input',render);
$('exportBtn').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='absahnaz-demo-records.json';a.click();URL.revokeObjectURL(a.href)});
$('printBtn').addEventListener('click',()=>window.print());
$('clearBtn').addEventListener('click',()=>{if(confirm('Permanently clear all Absahnaz demo records saved in this browser?')){data={children:[],members:[],donations:[],activity:[]};localStorage.removeItem(STORAGE_KEY);render()}});
load();render();
</script>
</body>
</html>
